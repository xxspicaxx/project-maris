# =========================================================================
# MARITIME FLEET ERP — ENV TEMPLATE
# Copy to .env for local/docker environments
# =========================================================================

# --- NestJS API Backend Environment ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Database Connection
# Use 'localhost' for running apps locally outside Docker, 'postgres' when running inside Docker Compose
DATABASE_URL=postgresql://user:password@localhost:5432/maritime_erp_dev?schema=public

# JWT Security
# Ensure to generate a cryptographically strong secret (min 32 chars) in staging/production
JWT_SECRET=dev-jwt-secret-minimum-32-characters-long-key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis Caching & Queue
# Use 'localhost' for running apps locally outside Docker, 'redis' when running inside Docker Compose
REDIS_URL=redis://localhost:6379

# Storage (MinIO)
# Use 'localhost' for running apps locally outside Docker, 'minio' when running inside Docker Compose
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=maritime-docs

# Email Server (Mailhog)
# Use 'localhost' for running apps locally outside Docker, 'mailhog' when running inside Docker Compose
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- Next.js Frontend Web Environment ---
# Port configuration for proxy routing and client-side communication
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXTAUTH_SECRET=dev-nextauth-secret-min-32-chars-long-key
NEXTAUTH_URL=http://localhost:3000
