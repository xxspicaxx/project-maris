# Stage 1: Development
FROM node:20-alpine AS development

WORKDIR /workspace

# Install pnpm
RUN npm install -g pnpm@8

# Install tools yang dibutuhkan
RUN apk add --no-cache git openssl curl

# Copy lock files and workspace config
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/config/package.json ./packages/config/package.json

# Install dependencies
RUN pnpm install

# Expose port
EXPOSE 4000

# Default command for development (installs delta deps, generates prisma client, pushes schema at startup)
CMD ["sh", "-c", "pnpm install && npx prisma generate && npx prisma db push && pnpm dev:api"]

# Stage 2: Build
FROM node:20-alpine AS build

WORKDIR /workspace

# Install pnpm
RUN npm install -g pnpm@8

# Copy lock files and workspace config
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/config/package.json ./packages/config/package.json

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy all source files
COPY . .

# Generate Prisma client
RUN cd prisma && npx prisma generate

# Build the API
RUN pnpm build:api

# Stage 3: Production
FROM node:20-alpine AS production

WORKDIR /workspace

# Create directory and set permissions for node user
RUN chown -R node:node /workspace

# Install tools
RUN apk add --no-cache openssl curl

# Copy build output & node_modules
COPY --from=build --chown=node:node /workspace/apps/api/dist ./apps/api/dist
COPY --from=build --chown=node:node /workspace/apps/api/node_modules ./apps/api/node_modules
COPY --from=build --chown=node:node /workspace/packages ./packages
COPY --from=build --chown=node:node /workspace/prisma ./prisma
COPY --from=build --chown=node:node /workspace/package.json ./
COPY --from=build --chown=node:node /workspace/pnpm-lock.yaml ./
COPY --from=build --chown=node:node /workspace/pnpm-workspace.yaml ./

# Switch to non-root user
USER node

# Expose port
EXPOSE 4000

# Start API server
CMD ["node", "apps/api/dist/main"]