# Stage 1: Development
FROM node:20-alpine AS development

WORKDIR /workspace

# Install pnpm
RUN npm install -g pnpm@8

# Install tools
RUN apk add --no-cache git

# Expose port
EXPOSE 3000

# Default command for development
CMD ["pnpm", "dev:web"]

# Stage 2: Build
FROM node:20-alpine AS build

WORKDIR /workspace

# Install pnpm
RUN npm install -g pnpm@8

# Copy lock files and workspace config
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/config/package.json ./packages/config/package.json

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy all source files
COPY . .

# Build the web app
RUN pnpm build:web

# Stage 3: Production (Next.js SSR Server)
FROM node:20-alpine AS production

WORKDIR /workspace

# Install pnpm
RUN npm install -g pnpm@8

# Copy build output & workspaces
COPY --from=build /workspace/apps/web/.next ./apps/web/.next
COPY --from=build /workspace/apps/web/public ./apps/web/public
COPY --from=build /workspace/apps/web/package.json ./apps/web/package.json
COPY --from=build /workspace/apps/web/node_modules ./apps/web/node_modules
COPY --from=build /workspace/packages ./packages
COPY --from=build /workspace/package.json ./
COPY --from=build /workspace/pnpm-lock.yaml ./
COPY --from=build /workspace/pnpm-workspace.yaml ./

# Expose Next.js server port
EXPOSE 3000

# Start Next.js in production
CMD ["pnpm", "--filter", "@maris/web", "start"]