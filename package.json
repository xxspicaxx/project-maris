{
  "name": "maritime-fleet-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Maritime Fleet ERP — Enterprise system for Indonesian shipping fleet management",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @maris/api dev",
    "dev:web": "pnpm --filter @maris/web dev",
    "build": "turbo run build",
    "build:api": "pnpm --filter @maris/api build",
    "build:web": "pnpm --filter @maris/web build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "prisma": "^6.0.0",
    "tsx": "^4.22.4",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^17.4.2",
    "zod": "^3.22.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  }
}
